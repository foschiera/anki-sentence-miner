{
  "manifest_version": 3,
  "name": "Web Anki Miner",
  "version": "1.2.1",
  "description": "Minerador de texto, legendas em streaming e OCR leve para o Anki",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Web Anki Miner",
    "default_popup": "popup.html"
  },
  "commands": {
    "start-area-selection": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Selecionar uma área da página para OCR"
    }
  },
  "host_permissions": [
    "http://localhost:8765/*",
    "https://jisho.org/*",
    "https://translate.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-anki-miner@local",
      "strict_min_version": "126.0"
    }
  }
}
